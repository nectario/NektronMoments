# MySQL (either MYSQL_DSN or project-scoped vars)
# MYSQL_DSN=mysql://user:password@127.0.0.1:3306/ImageTracker?charset=utf8mb4
# NEKTRON_MOMENTS_MYSQL_HOST=127.0.0.1
# NEKTRON_MOMENTS_MYSQL_PORT=3306
# NEKTRON_MOMENTS_MYSQL_USER=user
# NEKTRON_MOMENTS_MYSQL_PASSWORD=password
# NEKTRON_MOMENTS_MYSQL_DATABASE=ImageTracker

# Compatibility fallbacks
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USERID=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE_NEKTRON_MOMENTS=ImageTracker

# OpenAI credential (process environment first, then ignored .env, then SSM)
OPENAI_API_KEY=
# Legacy monolith only; the app worker uses IAM-authenticated Amazon Location.
GOOGLE_MAPS_API_KEY=

# Legacy NektronMoments.py direct captioning
OPENAI_VISION_MODEL=gpt-5.2
PHOTO_CAPTION_MAX_WORDS=18

# Legacy NektronMoments.py location enrichment
LOCATION_NORMALIZATION_RULES_PATH=location_normalization_rules.json

# App foundation (non-secret values only)
NEKTRON_MOMENTS_STAGE=local
NEKTRON_MOMENTS_AWS_REGION=us-east-2
NEKTRON_MOMENTS_API_URL=
NEKTRON_MOMENTS_MEDIA_BUCKET=
NEKTRON_MOMENTS_DB_SECRET_PARAMETER=/imagetracker/prod/mysql
NEKTRON_MOMENTS_OPENAI_SECRET_PARAMETER=/imagetracker/prod/openai
NEKTRON_MOMENTS_ELEVENLABS_SECRET_PARAMETER=/imagetracker/prod/elevenlabs
NEKTRON_MOMENTS_LOCATION_NORMALIZATION_RULES_PATH=location_normalization_rules.json
NEKTRON_MOMENTS_GEOCODE_REUSE_RADIUS_METERS=5
NEKTRON_MOMENTS_GEOCODE_MONTHLY_CALL_LIMIT=1000
NEKTRON_MOMENTS_SCENE_DESCRIPTION_MODEL=gpt-5.6-sol
NEKTRON_MOMENTS_SCENE_DESCRIPTION_DETAIL=high
NEKTRON_MOMENTS_SCENE_DESCRIPTION_SERVICE_TIER=flex
NEKTRON_MOMENTS_SCENE_DESCRIPTION_MAX_WORDS=24
NEKTRON_MOMENTS_SCENE_DESCRIPTION_MONTHLY_CALL_LIMIT=1000
