<Window x:Class="NektronMoments.ProcessingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nektron Moments · Processing">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid x:Name="Surface" Background="{ThemeResource MomentsWindowBrush}" SizeChanged="SurfaceSizeChanged">
  <Grid.Resources>
   <ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
     <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#102739"/>
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#102739"/>
      <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#102739"/>
      <SolidColorBrush x:Key="EstimateFill" Color="#FFF8E9"/>
      <SolidColorBrush x:Key="EstimateStroke" Color="#F3D699"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#E6F1F8"/>
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#E6F1F8"/>
      <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#E6F1F8"/>
      <SolidColorBrush x:Key="EstimateFill" Color="#302B20"/>
      <SolidColorBrush x:Key="EstimateStroke" Color="#776440"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="EstimateFill" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="EstimateStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
     </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource MomentsTextBrush}"/><Setter Property="FontSize" Value="15"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource MomentsTextBrush}"/></Style>
    <Style x:Key="SectionCard" TargetType="Border"><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{ThemeResource MomentsBorderBrush}"/><Setter Property="Background" Value="{ThemeResource MomentsSurfaceBrush}"/><Setter Property="Padding" Value="12,6"/></Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="HideKey"/><KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopySelectedRows"/></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TitleBar x:Name="ProcessingTitleBar" Title="Nektron Moments · Processing" Background="{ThemeResource MomentsTitlebarBrush}" Foreground="{ThemeResource MomentsTextBrush}">
   <TitleBar.IconSource><ImageIconSource ImageSource="{ThemeResource MomentsActivityImage}"/></TitleBar.IconSource>
  </TitleBar>
  <ScrollViewer x:Name="ProcessingBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="14,8,14,6" Spacing="4">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5">
      <StackPanel Orientation="Horizontal" Spacing="14">
       <TextBlock x:Name="Heading" Text="Processing photos" FontSize="32" FontWeight="SemiBold"/>
       <Border Background="{ThemeResource MomentsSelectionBrush}" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,1" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" Text="Full" FontSize="16" FontWeight="SemiBold"/></Border>
      </StackPanel>
      <TextBlock x:Name="SessionText" Text="Preparing your library…" FontSize="15" Foreground="{ThemeResource MomentsMutedBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
      <FontIcon Glyph="&#xE917;" FontSize="20" Foreground="{ThemeResource MomentsMutedBrush}"/>
      <TextBlock x:Name="ElapsedText" FontSize="13" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <Border x:Name="SetupPanel" Style="{StaticResource SectionCard}">
     <Grid x:Name="OptionsGrid" ColumnSpacing="20" RowSpacing="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="AiChoices" Spacing="4">
       <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="AI enrichment" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center"/><Button x:Name="CatchUpButton" FontSize="13" Content="Catch up: 10,000 per source" Click="CatchUpClicked"/></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox x:Name="IncludeAiChoice" FontSize="13" Content="Enabled" IsChecked="True" Checked="SetupChanged" Unchecked="SetupChanged"/>
        <StackPanel x:Name="AiReadOnly" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed"><FontIcon x:Name="AiStateIcon" Glyph="&#xE73A;" FontSize="24" Foreground="{ThemeResource MomentsAccentBrush}"/><TextBlock x:Name="AiStateText" Text="Enabled" FontSize="13"/></StackPanel>
        <StackPanel x:Name="LockedNotice" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
         <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="{ThemeResource MomentsMutedBrush}"/>
         <TextBlock Text="Settings locked during processing" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/>
        </StackPanel>
       </StackPanel>

      </StackPanel>
      <ComboBox x:Name="ModelChoice" FontSize="13" Grid.Column="1" Header="Scene model" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="SetupChanged"/>
      <NumberBox x:Name="LimitChoice" FontSize="13" Grid.Column="2" Header="Assets per source" VerticalAlignment="Center" Minimum="1" Maximum="1000000" Value="64" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="LimitChanged"/>
      <StackPanel x:Name="ModelDisplay" Grid.Column="1" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Scene model" Foreground="{ThemeResource MomentsMutedBrush}" FontSize="13"/><Border Background="{ThemeResource MomentsSecondaryBrush}" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6"><TextBlock x:Name="ModelValue" FontSize="13"/></Border></StackPanel>
      <StackPanel x:Name="LimitDisplay" Grid.Column="2" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Assets per source" Foreground="{ThemeResource MomentsMutedBrush}" FontSize="13"/><Border Background="{ThemeResource MomentsSecondaryBrush}" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6"><TextBlock x:Name="LimitValue" FontSize="13"/></Border></StackPanel>
     </Grid>
    </Border>
    <Grid x:Name="PricingGrid" ColumnSpacing="14" RowSpacing="14"><Grid.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource MomentsTextBrush}"/></Style></Grid.Resources>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="PricingCard" Style="{StaticResource SectionCard}">
      <StackPanel Spacing="4">
       <StackPanel><TextBlock Text="Model pricing" Style="{StaticResource SectionTitle}" FontSize="18"/><TextBlock Text="USD per 1 million tokens" Foreground="{ThemeResource MomentsMutedBrush}"/></StackPanel>
       <Border CornerRadius="7" BorderThickness="1" BorderBrush="{ThemeResource MomentsBorderBrush}">
        <StackPanel>
         <Grid Padding="12,4" Background="{ThemeResource MomentsSecondaryBrush}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <TextBlock Text="Model" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Input" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Output" HorizontalAlignment="Right" FontWeight="SemiBold"/>
         </Grid>
         <ListView x:Name="PricingRows" SelectionMode="Single" IsItemClickEnabled="False" AutomationProperties.Name="Model pricing"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="24"/></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate><DataTemplate><Grid>

           <Border Width="3" Background="{ThemeResource MomentsAccentBrush}" HorizontalAlignment="Left" Visibility="{Binding Selected}" CornerRadius="2"/>
           <Grid Padding="12,2" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="15"/><Border Background="{ThemeResource MomentsSecondaryBrush}" CornerRadius="10" Padding="9,2" Visibility="{Binding Selected}"><TextBlock Text="This run" FontSize="11"/></Border></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Input}" HorizontalAlignment="Right" FontSize="15"/><TextBlock Grid.Column="2" Text="{Binding Output}" HorizontalAlignment="Right" FontSize="15"/>
           </Grid>
          </Grid></DataTemplate></ListView.ItemTemplate>
         </ListView>
        </StackPanel>
       </Border>
       <TextBlock Text="Rates: 21 Sep 2026 · Astra: 22 Sep 2026" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/>
      </StackPanel>
     </Border>
     <Border x:Name="EstimateCard" Grid.Column="1" Style="{StaticResource SectionCard}" Background="{ThemeResource EstimateFill}" BorderBrush="{ThemeResource EstimateStroke}">
      <StackPanel Spacing="4">
       <StackPanel Orientation="Horizontal" Spacing="4"><Image Source="ms-appx:///Assets/FluentDatabase.svg" Width="32" Height="32"/><TextBlock Text="Illustrative AI cost" Style="{StaticResource SectionTitle}" FontSize="18"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="EstimateAmount" Text="$63.20" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="USD" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="16"/></StackPanel>
       <TextBlock x:Name="EstimateCount" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
       <ListView x:Name="EstimateRows" SelectionMode="Single" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource EstimateStroke}" AutomationProperties.Name="Cost assumptions">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,2"/><Setter Property="MinHeight" Value="28"/></Style></ListView.ItemContainerStyle>
        <ListViewItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Model"/><TextBlock x:Name="EstimateModel" Grid.Column="1"/></Grid></ListViewItem>
        <ListViewItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Input per image"/><TextBlock Grid.Column="1" Text="2,560 tokens"/></Grid></ListViewItem>
        <ListViewItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Output per image"/><TextBlock Grid.Column="1" Text="100 tokens"/></Grid></ListViewItem>
       </ListView>
       <TextBlock Text="Illustrative estimate, not a quote or spending cap." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MomentsMutedBrush}"/>
      </StackPanel>
     </Border>
    </Grid>
    <TextBlock x:Name="SetupEstimate" Text="Actual cost varies with tokens, retries and pending jobs. Flex and cache reuse may lower costs. Excludes address lookup and AWS costs." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource MomentsMutedBrush}"/>
    <StackPanel Spacing="4">
     <TextBlock Text="Operations" Style="{StaticResource SectionTitle}"/>
     <Border CornerRadius="8" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="1">
      <StackPanel>
       <Grid Padding="12,4" Background="{ThemeResource MomentsSecondaryBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <TextBlock Text="#"/><TextBlock Grid.Column="1" Text="Source"/><TextBlock Grid.Column="2" Text="Status"/><TextBlock Grid.Column="3" Text="Current operation"/><TextBlock Grid.Column="4" Text="Items"/>
       </Grid>
       <ListView x:Name="OperationsList" SelectionMode="Extended" MinHeight="40" MaxHeight="96" Background="{ThemeResource MomentsSurfaceBrush}">
        <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,4"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding NumberText}"/><TextBlock Grid.Column="1" Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
         <Border Grid.Column="2" Background="{ThemeResource MomentsSecondaryBrush}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left"><TextBlock Text="{Binding State}" FontSize="13"/></Border>
         <TextBlock Grid.Column="3" Text="{Binding Phase}" ToolTipService.ToolTip="{Binding Phase}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
         <TextBlock Grid.Column="4" Text="{Binding CountText}"/>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Spacing="4">
     <Grid><TextBlock x:Name="LogHeading" Text="Activity log" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="FollowLog" Content="Follow latest" IsChecked="True" HorizontalAlignment="Right"/></Grid>
     <Border CornerRadius="8" BorderBrush="{ThemeResource MomentsBorderBrush}" BorderThickness="1">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="96"/></Grid.RowDefinitions>
       <Grid Padding="12,4" Background="{ThemeResource MomentsSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Time"/><TextBlock Grid.Column="1" Text="Operation"/><TextBlock Grid.Column="2" Text="Description"/></Grid>
       <ListView x:Name="LogList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="LogSelectionChanged" Background="{ThemeResource MomentsSurfaceBrush}">
        <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="30"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding TimeText}" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding Stage}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Grid.Column="2" Text="{Binding Message}" ToolTipService.ToolTip="{Binding Message}" FontSize="14" TextTrimming="CharacterEllipsis"/>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Border>
    </StackPanel>
    <StackPanel Spacing="4">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PhaseText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/><TextBlock x:Name="OverallText" Grid.Column="1"/></Grid>
     <Border Height="10" Background="{ThemeResource MomentsBorderBrush}" CornerRadius="5">
      <ProgressBar x:Name="PhaseBar" Minimum="0" Maximum="100" Height="10" AutomationProperties.Name="Current operation progress">
       <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackThickness">10</x:Double></ProgressBar.Resources>
      </ProgressBar>
     </Border>
     <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Overall source progress"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CountText" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"><TextBlock x:Name="RateText" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}"/><TextBlock x:Name="RemainingText" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}"/></StackPanel></Grid>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="FooterGrid" Grid.Row="2" Padding="14,6" Background="{ThemeResource MomentsTitlebarBrush}" RowSpacing="10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="FooterNotice" Margin="0,0,20,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{ThemeResource MomentsInfoImage}" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock x:Name="FooterText" Grid.Column="1" Text="Your library stays usable. Hiding keeps processing in the background." TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}" VerticalAlignment="Center"/></Grid>
   <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
    <Button x:Name="SavedQueuesButton" Content="Saved queues" Click="SavedQueuesClick"/>
    <Button x:Name="HideButton" Content="Hide" MinWidth="120" Click="HideClick" Style="{StaticResource AccentButtonStyle}"/>
    <Button x:Name="StartButton" Content="Start" MinWidth="120" Click="StartClick" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"/>
    <Button x:Name="StopButton" Content="Stop processing" MinWidth="145" Click="StopClick"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
