<Window x:Class="NektronMoments.ProcessingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="using:NektronMoments.Models" Title="Nektron Moments · Processing">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid x:Name="Surface" Background="{ThemeResource MomentsWindowBrush}">
  <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource MomentsTextBrush}"/></Style></Grid.Resources>
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="HideKey"/></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="0.7*" MinHeight="148"/><RowDefinition Height="1.3*" MinHeight="140"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TitleBar x:Name="ProcessingTitleBar" Title="Nektron Moments · Processing"
   Background="{ThemeResource MomentsTitlebarBrush}" Foreground="{ThemeResource MomentsTextBrush}">
   <TitleBar.IconSource><ImageIconSource ImageSource="{ThemeResource MomentsActivityImage}"/></TitleBar.IconSource>
  </TitleBar>
  <Grid Grid.Row="1" Padding="20,14,20,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4">
    <TextBlock x:Name="Heading" Text="Processing metadata" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource MomentsTextBrush}"/>
    <TextBlock x:Name="SessionText" Text="Preparing your library…" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <TextBlock x:Name="ElapsedText" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}"/>
   <StackPanel x:Name="SetupPanel" Grid.Row="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <CheckBox x:Name="IncludeAiChoice" Content="Include AI enrichment" IsChecked="True" VerticalAlignment="Center" Checked="SetupChanged" Unchecked="SetupChanged"/>
     <ComboBox x:Name="ModelChoice" Grid.Column="1" Header="Scene model · this run" HorizontalAlignment="Stretch" SelectionChanged="SetupChanged"/>
     <NumberBox x:Name="LimitChoice" Grid.Column="2" Header="Assets per source" Minimum="1" Maximum="1000000" Value="64" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="LimitChanged"/>
    </Grid>
    <Button Content="Catch up: 10,000 per source" Click="CatchUpClicked"/>
    <TextBlock x:Name="SetupPricing" TextWrapping="Wrap" FontSize="12"/>
    <TextBlock x:Name="SetupEstimate" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="20,0,20,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Operations" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{ThemeResource MomentsTextBrush}"/>
   <Grid Grid.Row="1" Padding="10,7" Background="{ThemeResource MomentsSecondaryBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="200"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <TextBlock Text="#"/><TextBlock Grid.Column="1" Text="Source"/><TextBlock Grid.Column="2" Text="State"/><TextBlock Grid.Column="3" Text="Current operation"/><TextBlock Grid.Column="4" Text="Items"/>
   </Grid>
   <ListView x:Name="OperationsList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False" Background="{ThemeResource MomentsSurfaceBrush}">
    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="32"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="200"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding NumberText}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding Phase}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="4" Text="{Binding CountText}" FontSize="12"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <Grid Grid.Row="3" Margin="20,0,20,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,8">
    <TextBlock x:Name="LogHeading" Text="Activity log" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource MomentsTextBrush}"/>
    <CheckBox x:Name="FollowLog" Content="Follow latest" IsChecked="True" HorizontalAlignment="Right" MinHeight="24" FontSize="12"/>
   </Grid>
   <Grid Grid.Row="1" Padding="10,7" Background="{ThemeResource MomentsSecondaryBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="Time"/><TextBlock Grid.Column="1" Text="Operation"/><TextBlock Grid.Column="2" Text="Description"/>
   </Grid>
   <ListView x:Name="LogList" Grid.Row="2" SelectionMode="None" Background="{ThemeResource MomentsSurfaceBrush}">
    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="28"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding TimeText}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Stage}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTipService.ToolTip="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <StackPanel Grid.Row="4" Margin="20,0,20,14" Spacing="7">
   <Grid><TextBlock Text="Overall source progress" FontSize="13" Foreground="{ThemeResource MomentsTextBrush}"/><TextBlock x:Name="OverallText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/></Grid>
   <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" Height="8" AutomationProperties.Name="Overall source progress"/>
   <Grid Margin="0,5,0,0"><TextBlock x:Name="PhaseText" FontSize="13" Foreground="{ThemeResource MomentsTextBrush}"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/></Grid>
   <ProgressBar x:Name="PhaseBar" Minimum="0" Maximum="100" Height="8" AutomationProperties.Name="Current operation progress"/>
   <Grid><TextBlock x:Name="RateText" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/><TextBlock x:Name="RemainingText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource MomentsMutedBrush}"/></Grid>
  </StackPanel>
  <Grid Grid.Row="5" Padding="20,12" Background="{ThemeResource MomentsTitlebarBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FooterText" Text="The library remains usable · Closing this window hides it" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,16,0" Foreground="{ThemeResource MomentsMutedBrush}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
    <Button x:Name="SavedQueuesButton" Content="Saved queues" Click="SavedQueuesClick"/>
    <Button x:Name="HideButton" Content="Hide" MinWidth="90" Click="HideClick"/>
    <Button x:Name="StartButton" Content="Start" MinWidth="100" Click="StartClick" Visibility="Collapsed"/>
    <Button x:Name="StopButton" Content="Stop processing" MinWidth="132" Click="StopClick"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
