<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NektronMoments.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NektronMoments">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Moments.Theme.xaml"/>
                <ResourceDictionary Source="Styles/Moments.Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <!-- WinUI also resolves thumb dimensions from application resources
                 when updating its native indicators after a view/size change. -->
            <x:Double x:Key="ScrollBarSize">24</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinHeight">48</x:Double>
            <x:Double x:Key="SmallScrollThumbScale">1</x:Double>
            <x:Double x:Key="SmallScrollThumbOffset">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
