<Page x:Class="NektronMoments.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NektronMoments.Models"
    xmlns:controls="using:NektronMoments.Controls"
    Background="{ThemeResource MomentsWindowBrush}" Foreground="{ThemeResource MomentsTextBrush}">
    <Grid x:Name="Root" Loaded="PageLoaded" SizeChanged="PageResized" Background="{ThemeResource MomentsWindowBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch"/>
            <KeyboardAccelerator Key="F5" Invoked="RefreshKey"/>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeKey"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CommandBar Background="{ThemeResource MomentsSurfaceBrush}" DefaultLabelPosition="Right" Padding="16,6">
            <CommandBar.Content>
                <AutoSuggestBox x:Name="SearchBox" Width="460" Margin="0,0,24,0"
                    PlaceholderText="Search your photos" QueryIcon="Find"
                    TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted"
                    AutomationProperties.Name="Search filenames; press Enter to search indexed descriptions and addresses"/>
            </CommandBar.Content>
            <AppBarButton x:Name="AddFolderButton" Label="Add folder" Click="AddFolder">
                <AppBarButton.Icon><ImageIcon Source="{ThemeResource MomentsAddImage}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Refresh" Click="RefreshLibrary" ToolTipService.ToolTip="Refresh library (F5)">
                <AppBarButton.Icon><ImageIcon Source="{ThemeResource MomentsRefreshImage}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Label="Theme" Click="ChangeTheme" ToolTipService.ToolTip="Switch light / dark theme">
                <AppBarButton.Icon><ImageIcon Source="{ThemeResource MomentsThemeImage}"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Activity" Click="ShowActivity">
                <AppBarButton.Icon><ImageIcon Source="{ThemeResource MomentsActivityImage}"/></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
            Background="{ThemeResource MomentsSecondaryBrush}"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
            OpenPaneLength="216" CompactPaneLength="48" ExpandedModeThresholdWidth="1000"
            SelectionChanged="NavigationChanged" Header="">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="YOUR LIBRARY"/>
                <NavigationViewItem x:Name="LibraryNav" Content="Library" Tag="all" IsSelected="True">
                    <NavigationViewItem.Icon><ImageIcon Source="{ThemeResource MomentsLibraryImage}"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Photos" Tag="Photo">
                    <NavigationViewItem.Icon><ImageIcon Source="{ThemeResource MomentsPhotosImage}"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Videos" Tag="Video">
                    <NavigationViewItem.Icon><ImageIcon Source="{ThemeResource MomentsVideosImage}"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItemHeader Content="LOCAL SOURCES"/>
            </NavigationView.MenuItems>
            <SplitView x:Name="DetailsSplit" PanePlacement="Right" OpenPaneLength="320"
                DisplayMode="Inline" IsPaneOpen="False" PaneBackground="{ThemeResource MomentsSurfaceBrush}">
                <SplitView.Pane>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="22,26,22,24" Spacing="6">
                            <Grid>
                                <TextBlock Text="Photo details" x:Name="DetailHeading" FontSize="16" FontWeight="SemiBold"/>
                                <Button Content="×" HorizontalAlignment="Right" Padding="8,0" Click="CloseDetails" AutomationProperties.Name="Close details"/>
                            </Grid>
                            <controls:MediaThumbnail x:Name="DetailThumbnail" Height="192" Margin="0,12,0,8"/>
                            <TextBlock x:Name="DetailName" Style="{StaticResource DetailValue}" FontSize="17" FontWeight="SemiBold"/>
                            <Button Content="View photo / video" Click="ViewMedia" HorizontalAlignment="Stretch" Margin="0,8,0,4"/>
                            <TextBlock Text="CAPTURE DATE" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailDate" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailDescription" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="LOCATION / ADDRESS" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailLocation" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="FILE" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailFile" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="SOURCE" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailSource" Style="{StaticResource DetailValue}"/>
                            <TextBlock Text="FILE IDENTITY" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailIdentity" Style="{StaticResource DetailValue}"/>
                            <TextBlock x:Name="DetailNotice" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,8" Foreground="{ThemeResource MomentsMutedBrush}"/>
                            <Button Content="Open original" Click="OpenOriginal" HorizontalAlignment="Stretch"/>
                            <Button Content="Show in folder" Click="RevealOriginal" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </SplitView.Pane>
                <Grid Padding="28,24,24,12" Background="{ThemeResource MomentsWindowBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5" Margin="0,0,0,20">
                        <TextBlock x:Name="LibraryHeading" Text="Your moments, found." FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LibrarySubtitle" Text="Connecting to your library…" FontSize="14" Foreground="{ThemeResource MomentsMutedBrush}"/>
                    </StackPanel>
                    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Warning" Margin="0,0,0,12"/>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock x:Name="ResultCount" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource MomentsMutedBrush}"/>
                        <Button x:Name="SortButton" Content="Newest first ↓" HorizontalAlignment="Right" Click="ToggleSort" Padding="12,6"/>
                    </Grid>
                    <GridView x:Name="Gallery" Grid.Row="3" ItemsSource="{x:Bind Items}" SizeChanged="GalleryResized"
                        DoubleTapped="GalleryDoubleTapped"
                        IsItemClickEnabled="True" ItemClick="MediaClicked" SelectionMode="Single"
                        ContainerContentChanging="GalleryContainerChanging"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid x:Name="MediaWrap" Orientation="Horizontal" ItemWidth="242" ItemHeight="224"/></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Grid Background="{ThemeResource MomentsSurfaceBrush}" CornerRadius="10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
                                    <controls:MediaThumbnail Item="{x:Bind}" CornerRadius="10,10,0,0"/>
                                    <StackPanel Grid.Row="1" Padding="12,7" Spacing="3">
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource MomentsMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.Footer>
                            <Button x:Name="LoadMoreButton" Content="Load more photos" Click="LoadMore" Margin="0,12" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </GridView.Footer>
                    </GridView>
                    <StackPanel x:Name="EmptyState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="400">
                        <ContentControl Width="54" Height="54" HorizontalAlignment="Center" ContentTemplate="{ThemeResource MomentsIconLibrary}"/>
                        <TextBlock x:Name="EmptyTitle" Text="Bringing your library into view" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyMessage" Text="Originals stay on your computer. Thumbnails load as you browse." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MomentsMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </SplitView>
        </NavigationView>
        <Grid Grid.Row="2" Background="{ThemeResource MomentsTitlebarBrush}" Padding="18,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="12" Text="Opening local library…" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MomentsMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="Nektron Moments · Windows preview" FontSize="11" Margin="16,0,0,0" Foreground="{ThemeResource MomentsMutedBrush}"/>
        </Grid>
        <ProgressBar x:Name="Busy" Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="True" Height="2" Visibility="Collapsed"/>
    </Grid>
</Page>
