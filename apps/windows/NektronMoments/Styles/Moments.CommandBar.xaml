<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep native command/overflow behavior. ImageIcon dimensions alone are
         insufficient: the stock AppBarButton Viewbox otherwise shrinks to 16 DIP. -->
    <x:Double x:Key="AppBarButtonContentHeight">24</x:Double>
    <x:Double x:Key="AppBarThemeCompactHeight">48</x:Double>
    <x:Double x:Key="AppBarThemeMinHeight">48</x:Double>
    <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
        <Setter Property="Width" Value="40"/>
    </Style>
    <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
    <Thickness x:Key="AppBarButtonContentViewboxCompactMargin">0,12</Thickness>
    <Thickness x:Key="AppBarButtonContentViewboxMargin">12,12,0,12</Thickness>
    <Thickness x:Key="AppBarButtonTextLabelOnRightMargin">10,18,14,18</Thickness>
    <Thickness x:Key="CommandBarMoreButtonMargin">14,0</Thickness>
</ResourceDictionary>
